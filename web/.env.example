NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_OUT_URL=/sign-in

# ml-services base URL, used server-side only by app/api/* proxy routes.
# ml-services is NOT deployed to the cloud — it only runs locally. Set
# this to http://localhost:8000 for local dev/demo (start ml-services
# yourself first: `cd ml-services && uvicorn app.main:app --reload`).
# If you need a deployed Vercel instance of web/ to reach your local
# ml-services (e.g. for a live public demo), tunnel it instead (e.g.
# `ngrok http 8000`) and set this to the tunnel's https URL in Vercel's
# project environment variables — never point it at a public URL you
# don't control.
ML_SERVICE_URL=http://localhost:8000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=